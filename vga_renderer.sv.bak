// vga_renderer.sv
// Reads text buffer tb[0..2399] and font ROM (4096 bytes) and generates RGB outputs.
// Requires: text_buffer writing the char memory at tb[] (internal linkage is simplest).
module vga_renderer (
    input  wire clk,
    input  wire rst_n,
    output wire VGA_HS,
    output wire VGA_VS,
    output wire [3:0] VGA_R,
    output wire [3:0] VGA_G,
    output wire [3:0] VGA_B
);
    // instantiate timing
    wire [9:0] h_cnt, v_cnt;
    wire hsync, vsync, visible;
    vga_timing vt (
        .clk(clk),
        .rst_n(rst_n),
        .h_cnt(h_cnt),
        .v_cnt(v_cnt),
        .hsync(hsync),
        .vsync(vsync),
        .visible(visible)
    );
    assign VGA_HS = hsync;
    assign VGA_VS = vsync;

    // char coordinates: 8x16 font -> 640/8=80 columns, 480/16=30 rows
    wire [6:0] char_x = h_cnt[9:3]; // div by 8
    wire [4:0] char_y = v_cnt[9:4]; // div by 16

    // pixel within char
    wire [2:0] px = h_cnt[2:0]; // 0..7
    wire [3:0] py = v_cnt[3:0]; // 0..15

    // text buffer memory: read via $readmemh from a file generated by text_buffer or
    // we can expose a dual-port mem. For simplicity, renderer will try to read "tb.bin" at init
    reg [7:0] tb_mem [0:2399];
    initial begin
        // If you want a static snapshot, generate tb.hex (from assembler or CPU)
        // For now fill with spaces
        integer i;
        for (i = 0; i < 2400; i = i + 1) tb_mem[i] = 8'h20;
        // Optionally load an initial file "tb.hex" to show something right away:
        if ($test$plusargs("load_tb")) begin
            $readmemh("tb.hex", tb_mem);
            $display("vga_renderer: loaded tb.hex");
        end
    end

    // font memory: 256 chars * 16 rows = 4096 bytes
    reg [7:0] font_mem [0:4095];
    initial begin
        $readmemh("font.hex", font_mem);
        $display("vga_renderer: loaded font.hex (expected 4096 bytes)");
    end

    // get character index and fetch font row
    wire [11:0] tb_idx = char_y * 80 + char_x; // 0..2399
    wire [7:0] ch = tb_mem[tb_idx];
    // font address: ch*16 + py
    wire [11:0] font_addr = ch * 16 + py;
    wire [7:0] font_row = font_mem[font_addr];

    wire pixel_on = font_row[7 - px]; // MSB is leftmost pixel

    // palette: background black, text white; highlight for registers etc can be implemented
    wire [3:0] color_r = pixel_on ? 4'hF : 4'h0;
    wire [3:0] color_g = pixel_on ? 4'hF : 4'h0;
    wire [3:0] color_b = pixel_on ? 4'hF : 4'h0;

    assign VGA_R = visible ? color_r : 4'h0;
    assign VGA_G = visible ? color_g : 4'h0;
    assign VGA_B = visible ? color_b : 4'h0;

endmodule
